# ip-allowlist main configuration
# Format: strict key=value, one per line. '#' starts a comment. Unknown keys
# are rejected. Values may be quoted. Paths without a leading '/' are relative
# to this file's directory. Path values must not contain spaces.

# --- targets ---------------------------------------------------------------
firewall_enabled=true
fail2ban_enabled=false
firewall_backend=nft              # nft | ufw | firewalld (required when firewall_enabled=true).
                                  # The installer preselects an active ufw/firewalld, else nft.
allow_conflicting_firewall=false  # true: proceed even if another manager is active

# --- sources ---------------------------------------------------------------
sources_dir=/etc/ip-allowlist/sources.d
allow_empty_sources=false         # true: allow clearing everything when no source is active

# --- default allow rules (a source may override any of these) --------------
allow_ports=80,443                # 443 | 80,443 | 20000-40000 | all
allow_protocol=tcp+udp            # tcp | udp | tcp+udp (ignored when allow_ports=all)
enable_ipv4=true
enable_ipv6=true
ipv6_required=false
http_timeout=15                   # seconds
http_retries=3
user_agent=ip-allowlist
min_entries=                      # empty -> 1; raise for large network sources
max_shrink_ratio=0.5

# --- schedule and self-update ---------------------------------------------
update_interval=1d                # default per-source fetch interval
timer_interval=15m                # systemd timer cadence (unit generation)
update_on_boot=true
auto_update=false                 # false: only report new versions
update_check_interval=1d
repo=SemouSky/ip-allowlist        # used by 'upgrade'

# --- fail2ban --------------------------------------------------------------
fail2ban_ignoreip_file=/etc/fail2ban/jail.d/zz-ip-allowlist.local
fail2ban_merge_existing=true

# --- firewalld -------------------------------------------------------------
firewalld_zone=                   # empty -> firewalld default zone

# --- paths and locking -----------------------------------------------------
state_dir=/var/lib/ip-allowlist
snapshot_retention=3
lock_file=/run/ip-allowlist.lock
lock_wait=30                      # seconds to wait for the lock on manual runs

# --- logging ---------------------------------------------------------------
log_level=info                    # debug | info | warn | error
# log_target: auto | stdout | file | syslog | none (comma separated).
#   auto    -> log to stdout/stderr only. Under systemd that means the journal
#              (view with: journalctl -u ip-allowlist.service -f); when run from
#              a terminal it is the terminal. 'auto' never writes a file.
#   stdout  -> same destination as auto, stated explicitly.
#   file    -> append to log_file (requires log_file below).
#   syslog  -> send to syslog via logger (tag ip-allowlist).
#   none    -> no log output.
# Combine to fan out, e.g. log_target=stdout,file.
log_target=auto
log_file=                         # required when log_target includes 'file'
log_format=text                   # text | json

# --- config schema (optional) ---------------------------------------------
# schema_version=1
