# Cloudflare IP ranges source
# Place in /etc/ip-allowlist/sources.d/cloudflare.conf
# Disabled by default: enable it only if you actually put Cloudflare in front.
#
# All keys below are [source-overridable] in config.conf unless noted otherwise.

name=cloudflare
enabled=false
type=http
urls=https://www.cloudflare.com/ips-v4 https://www.cloudflare.com/ips-v6
format=text

# --- allow rules for this source ------------------------------------------
# "all" allows every port from these addresses; a list (443, 80,443,
# 20000-40000) narrows the rule. allow_protocol is ignored while this is "all".
allow_ports=all
allow_protocol=tcp+udp

# --- per-source target switches (logical AND with the main config) --------
# firewall_enabled:
#   true  -> when the main firewall_enabled=true, this source is applied as
#            allow rules (its own sets/chains/rules or ufw/firewalld objects).
#   false -> this source is excluded from the firewall; if it had been applied,
#            its objects are removed on the next sync. Its ranges are still
#            fetched, cached and available to the fail2ban union.
# fail2ban_enabled:
#   true  -> when the main fail2ban_enabled=true, this source's ranges are
#            merged into the [DEFAULT] ignoreip union.
#   false -> this source is excluded from the ignoreip union.
# Omit either key to inherit the main config value. Both switches are part of
# the source's effective hash, so changing one triggers a rebuild of this source
# on the next sync.
firewall_enabled=true
fail2ban_enabled=true

# --- refresh and safety thresholds ---------------------------------------
# Per-source override of the main update_interval.
update_interval=7d
min_entries=5
# max_shrink_ratio=0.5

# --- optional per-source overrides ---------------------------------------
# enable_ipv4=true
# enable_ipv6=true
# ipv6_required=false
# http_timeout=15
# http_retries=3
# user_agent=ip-allowlist
