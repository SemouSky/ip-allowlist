#!/usr/bin/env bash
# ip-allowlist: manage firewall allow-lists from Cloudflare and other sources.
#
# This is the main entry point. Backend/library code lives in lib/.
#
# Exit codes:
#   0 success / OK
#   1 warning (status --check)
#   2 critical / operational failure (status --check)
#   3 unknown (status --check)
#   >3 fatal error

set -uo pipefail

# ---------------------------------------------------------------------------
# Self-location
# ---------------------------------------------------------------------------

resolve_script_dir() {
  local src="${BASH_SOURCE[0]}"
  local dir
  while [[ -L "$src" ]]; do
    dir=$(cd -P "$(dirname -- "$src")" && pwd)
    src=$(readlink -- "$src")
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname -- "$src")" && pwd
}

IP_ALLOWLIST_ROOT="$(resolve_script_dir)"
export IP_ALLOWLIST_ROOT

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

COMMAND=""
CONFIG_FILE=""
JSON_OUT=0
FORCE=0
PURGE=0
STATUS_CHECK=0
UPGRADE_CHECK=0
ASSUME_YES=0
LOG_LEVEL_CLI=0
ALLOW_EMPTY=0
OFFLINE=0
AUTO_UPDATE_FAILED=0
UPGRADE_SYNC=0
HELP_TOPIC=""
UPGRADE_VERSION=""
FROM_TARBALL=""
FROM_DIR=""
SOURCE_FILTER=()

usage() {
  cat <<'EOF'
ip-allowlist - manage firewall allow-lists from Cloudflare and other sources

Usage: ip-allowlist [command] [options]

Commands:
  sync (default, alias: run)
                   Fetch sources and apply allow-lists
  check            Validate config and sources, report changes without applying
  apply-offline    Apply allow-lists from cached state (no network)
  sources          List configured sources
  status           Show current status (--check for Nagios format)
  cleanup          Remove all ip-allowlist firewall objects and fail2ban drop-in
  version          Show version information
  upgrade          Check for and install updates
  install          Install ip-allowlist system-wide
  uninstall        Remove ip-allowlist (--purge to remove data)
  help [command]   Show help (optionally for one command)

Options:
  --config FILE      Use alternative config file
  --source NAME      Limit sync/check/status to a source (repeatable)
  --json             JSON output (sources, status)
  --verbose          Enable debug logging
  --quiet            Only warnings and errors
  --dry-run          Show what would change without applying
  --force            Bypass intervals, hash skip, shrink guard and conflicts
  --allow-empty      Allow clearing everything when no source is active
  --check            Nagios-style status check (status) or check-only (upgrade)
  --offline          check: validate config only, no network
  --version VER      upgrade: install a specific version
  --from-dir DIR     upgrade: install from an unpacked tree
  --from-tarball F   upgrade: install from a tarball
  --sync             upgrade: run a sync immediately after upgrading
  --purge            Remove data/state on uninstall
  --yes              Assume yes for prompts
  --version          Show version
  -h, --help         Show this help

Environment:
  IP_ALLOWLIST_CONFIG   Alternative config file path
  LOG_LEVEL             Override logging level (debug|info|warn|error)
EOF
}

# Per-command help. Usage: usage_for <command>
usage_for() {
  case "$1" in
    sync|run)
      cat <<'EOF'
ip-allowlist sync [options]

Fetch all enabled sources, apply the firewall allow-list and reconcile the
fail2ban drop-in. This is the default command.

Options:
  --source NAME   Limit the run to one source (repeatable); unselected sources
                  are preserved and never treated as orphans.
  --force         Bypass update intervals, the shrink guard and firewall
                  conflict detection.
  --allow-empty   Allow clearing everything when no source is active.
  --dry-run       Log the planned actions without changing anything.
EOF
      ;;
    check)
      cat <<'EOF'
ip-allowlist check [--source NAME] [--offline] [--json]

Fetch and validate sources, report which ones would change, and write nothing.
  --offline   Validate the configuration only; do not use the network.
EOF
      ;;
    status)
      cat <<'EOF'
ip-allowlist status [--source NAME] [--check] [--json]

Show version, backend, verification, desired/applied hashes, fail2ban status
and the latest known version.
  --check   Nagios style: exit non-zero on stale/never-successful sources,
            missing artifacts or a residual previous backend.
  --json    Machine readable output.
EOF
      ;;
    sources)
      cat <<'EOF'
ip-allowlist sources [--json]

List configured sources with type, target, due state, status and last success.
EOF
      ;;
    upgrade)
      cat <<'EOF'
ip-allowlist upgrade [--check] [--version VER] [--from-dir DIR]
                     [--from-tarball FILE] [--sync] [--force]

Check for and install updates.
  --check            Report the available version only.
  --version VER      Install a specific version (only newer unless --force).
  --from-dir DIR     Install from an unpacked tree (offline).
  --from-tarball F   Install from a tarball (offline).
  --sync             Run a sync immediately after upgrading.
EOF
      ;;
    cleanup)
      cat <<'EOF'
ip-allowlist cleanup

Remove all ip-allowlist firewall objects and the fail2ban drop-in, and
invalidate the applied hashes so the next sync rebuilds the allow-list.
EOF
      ;;
    apply-offline)
      cat <<'EOF'
ip-allowlist apply-offline

Rebuild the firewall from cached state without network access (used by the
boot service on the nft backend).
EOF
      ;;
    version)
      cat <<'EOF'
ip-allowlist version [--json]

Show the version and where the running copy was installed from.
EOF
      ;;
    install|uninstall)
      cat <<EOF
ip-allowlist $1 [options]

Delegates to $1.sh. See $1.sh --help for details.
EOF
      ;;
    *)
      usage
      ;;
  esac
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      help)
        COMMAND="help"
        if [[ $# -gt 1 ]]; then
          case "$2" in
            sync|run|check|apply-offline|sources|status|cleanup|version|upgrade|install|uninstall) HELP_TOPIC="$2" ;;
          esac
        fi
        ;;
      sync|run|check|apply-offline|sources|status|cleanup|version|upgrade|install|uninstall)
        if [[ "$COMMAND" != "help" ]]; then
          case "$1" in
            run) COMMAND="sync" ;;
            *) COMMAND="$1" ;;
          esac
        fi
        ;;
      --source)
        shift
        [[ $# -gt 0 ]] || { err "--source requires an argument"; exit 64; }
        SOURCE_FILTER+=("$1")
        ;;
      --source=*) SOURCE_FILTER+=("${1#*=}") ;;
      --allow-empty) ALLOW_EMPTY=1 ;;
      --offline) OFFLINE=1 ;;
      --sync) UPGRADE_SYNC=1 ;;
      --from-dir)
        shift
        [[ $# -gt 0 ]] || { err "--from-dir requires an argument"; exit 64; }
        FROM_DIR="$1"
        ;;
      --from-dir=*) FROM_DIR="${1#*=}" ;;
      --from-tarball)
        shift
        [[ $# -gt 0 ]] || { err "--from-tarball requires an argument"; exit 64; }
        FROM_TARBALL="$1"
        ;;
      --from-tarball=*) FROM_TARBALL="${1#*=}" ;;
      --config)
        shift
        [[ $# -gt 0 ]] || { err "--config requires an argument"; exit 64; }
        CONFIG_FILE="$1"
        ;;
      --config=*)
        CONFIG_FILE="${1#*=}"
        ;;
      --json) JSON_OUT=1 ;;
      --verbose|-v) LOG_LEVEL="$LOG_LEVEL_DEBUG"; LOG_LEVEL_CLI=1 ;;
      --quiet|-q) QUIET=1; LOG_LEVEL="$LOG_LEVEL_WARN"; LOG_LEVEL_CLI=1 ;;
      --dry-run) DRY_RUN=1 ;;
      --force) FORCE=1 ;;
      --check) STATUS_CHECK=1; UPGRADE_CHECK=1 ;;
      --purge) PURGE=1 ;;
      --yes|-y) ASSUME_YES=1 ;;
      --version) COMMAND="version" ;;
      --version=*) UPGRADE_VERSION="${1#*=}" ;;
      --upgrade-version)
        shift
        [[ $# -gt 0 ]] || { err "--upgrade-version requires an argument"; exit 64; }
        UPGRADE_VERSION="$1"
        ;;
      -h|--help) COMMAND="help" ;;
      *)
        err "unknown argument: $1"
        usage >&2
        exit 64
        ;;
    esac
    shift
  done

  [[ -n "$COMMAND" ]] || COMMAND="sync"
}

# ---------------------------------------------------------------------------
# Libraries
# ---------------------------------------------------------------------------

load_libraries() {
  local lib="$IP_ALLOWLIST_ROOT/lib"
  # shellcheck source=/dev/null
  source "$lib/common.sh"
  # shellcheck source=/dev/null
  source "$lib/source.sh"
  # shellcheck source=/dev/null
  source "$lib/state.sh"
  # shellcheck source=/dev/null
  source "$lib/fail2ban.sh"

  IP_ALLOWLIST_VERSION="$(read_version)"
}

# Single source of truth for the supported firewall backends.
is_valid_backend() {
  case "$1" in
    nft|ufw|firewalld) return 0 ;;
    *) return 1 ;;
  esac
}

load_backend() {
  local backend="$1"
  is_valid_backend "$backend" || die "invalid firewall_backend '$backend' (expected nft, ufw or firewalld)"
  local file="$IP_ALLOWLIST_ROOT/lib/firewall/${backend}.sh"
  [[ -f "$file" ]] || die "firewall backend implementation not found: $file"
  # shellcheck source=/dev/null
  source "$file"
}

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

declare -A MAIN=()
# Highest config schema version this build understands.
readonly CONFIG_SCHEMA_VERSION=1
CONFIG_BASE_DIR=""
STATE_DIR=""
SOURCES_DIR=""
BACKEND=""
# nft object names are fixed by the plan; kept internal (not config keys).

FIREWALL_ENABLED="true"
FAIL2BAN_ENABLED="true"
ALLOW_CONFLICTING_FIREWALL="false"
ALLOW_EMPTY_SOURCES="false"

FAIL2BAN_DROPIN="/etc/fail2ban/jail.d/zz-ip-allowlist.local"
FAIL2BAN_MERGE_EXISTING="true"
FIREWALLD_ZONE=""
# Set by cmd_sync to drive per-source nft updates.
FIREWALL_CHANGED_SOURCES=()
FIREWALL_REMOVED_SOURCES=()
FIREWALL_FULL_REBUILD=0

UPDATE_INTERVAL=86400
TIMER_INTERVAL=900
UPDATE_ON_BOOT="true"
AUTO_UPDATE="false"
UPDATE_CHECK_INTERVAL=86400
REPO="SemouSky/ip-allowlist"

SNAPSHOT_RETENTION=3
LOCK_FILE="/run/ip-allowlist.lock"
LOCK_WAIT=30

DEFAULT_ALLOW_PORTS="443"
DEFAULT_ALLOW_PROTOCOL="tcp+udp"
DEFAULT_ENABLE_IPV4="true"
DEFAULT_ENABLE_IPV6="true"
DEFAULT_IPV6_REQUIRED="false"
DEFAULT_HTTP_TIMEOUT=15
DEFAULT_HTTP_RETRIES=3
DEFAULT_USER_AGENT="ip-allowlist"
DEFAULT_MIN_ENTRIES=""
DEFAULT_MAX_SHRINK_RATIO="0.5"
DEFAULT_FIREWALL_ENABLED="true"
DEFAULT_FAIL2BAN_ENABLED="true"

locate_config() {
  if [[ -n "$CONFIG_FILE" ]]; then
    printf '%s' "$CONFIG_FILE"
    return 0
  fi
  if [[ -n "${IP_ALLOWLIST_CONFIG:-}" ]]; then
    printf '%s' "$IP_ALLOWLIST_CONFIG"
    return 0
  fi
  if [[ -f /etc/ip-allowlist/config.conf ]]; then
    printf '%s' "/etc/ip-allowlist/config.conf"
    return 0
  fi
  if [[ -f "$IP_ALLOWLIST_ROOT/config/config.conf" ]]; then
    printf '%s' "$IP_ALLOWLIST_ROOT/config/config.conf"
    return 0
  fi
  printf '%s' ""
}

  LOG_COMPONENT=config
load_main_config() {
  local file
  file=$(locate_config)
  if [[ -z "$file" ]]; then
    die "no config file found (looked for /etc/ip-allowlist/config.conf). Run: ip-allowlist install"
  fi
  [[ -f "$file" ]] || die "config file not found: $file"
  CONFIG_FILE="$file"
  CONFIG_BASE_DIR=$(cd -P "$(dirname -- "$file")" && pwd)

  kv_load_file MAIN "$file"
  kv_reject_unknown MAIN "$file" \
    schema_version firewall_enabled fail2ban_enabled firewall_backend \
    allow_conflicting_firewall sources_dir allow_empty_sources \
    allow_ports allow_protocol enable_ipv4 enable_ipv6 ipv6_required \
    http_timeout http_retries user_agent min_entries max_shrink_ratio \
    update_interval timer_interval update_on_boot auto_update \
    update_check_interval repo fail2ban_ignoreip_file fail2ban_merge_existing \
    firewalld_zone state_dir snapshot_retention lock_file lock_wait \
    log_level log_target log_file log_format

  FIREWALL_ENABLED=$(normalize_bool "${MAIN[firewall_enabled]:-true}")
  validate_bool "firewall_enabled" "$FIREWALL_ENABLED" "$file"
  FAIL2BAN_ENABLED=$(normalize_bool "${MAIN[fail2ban_enabled]:-true}")
  validate_bool "fail2ban_enabled" "$FAIL2BAN_ENABLED" "$file"
  ALLOW_CONFLICTING_FIREWALL=$(normalize_bool "${MAIN[allow_conflicting_firewall]:-false}")
  validate_bool "allow_conflicting_firewall" "$ALLOW_CONFLICTING_FIREWALL" "$file"
  ALLOW_EMPTY_SOURCES=$(normalize_bool "${MAIN[allow_empty_sources]:-false}")
  validate_bool "allow_empty_sources" "$ALLOW_EMPTY_SOURCES" "$file"
  UPDATE_ON_BOOT=$(normalize_bool "${MAIN[update_on_boot]:-true}")
  validate_bool "update_on_boot" "$UPDATE_ON_BOOT" "$file"
  AUTO_UPDATE=$(normalize_bool "${MAIN[auto_update]:-false}")
  validate_bool "auto_update" "$AUTO_UPDATE" "$file"
  FAIL2BAN_MERGE_EXISTING=$(normalize_bool "${MAIN[fail2ban_merge_existing]:-true}")
  validate_bool "fail2ban_merge_existing" "$FAIL2BAN_MERGE_EXISTING" "$file"

  BACKEND="${MAIN[firewall_backend]:-}"
  if [[ "$FIREWALL_ENABLED" == "true" ]]; then
    [[ -n "$BACKEND" ]] || die "config: firewall_backend is required when firewall_enabled=true"
  fi
  if [[ -n "$BACKEND" ]]; then
    is_valid_backend "$BACKEND" || die "config: invalid firewall_backend '$BACKEND'"
  fi

  local ap="${MAIN[allow_ports]:-443}"
  valid_ports_spec "$ap" || die "config: invalid allow_ports '$ap'"
  DEFAULT_ALLOW_PORTS=$(normalize_ports "$ap")
  local apr="${MAIN[allow_protocol]:-tcp+udp}"
  valid_protocol_spec "$apr" || die "config: invalid allow_protocol '$apr'"
  DEFAULT_ALLOW_PROTOCOL=$(normalize_protocol "$apr")
  DEFAULT_ENABLE_IPV4=$(normalize_bool "${MAIN[enable_ipv4]:-true}")
  validate_bool "enable_ipv4" "$DEFAULT_ENABLE_IPV4" "$file"
  DEFAULT_ENABLE_IPV6=$(normalize_bool "${MAIN[enable_ipv6]:-true}")
  validate_bool "enable_ipv6" "$DEFAULT_ENABLE_IPV6" "$file"
  if [[ "$DEFAULT_ENABLE_IPV4" == "false" && "$DEFAULT_ENABLE_IPV6" == "false" ]]; then
    die "config: enable_ipv4 and enable_ipv6 cannot both be false"
  fi
  DEFAULT_IPV6_REQUIRED=$(normalize_bool "${MAIN[ipv6_required]:-false}")
  validate_bool "ipv6_required" "$DEFAULT_IPV6_REQUIRED" "$file"

  DEFAULT_HTTP_TIMEOUT="${MAIN[http_timeout]:-15}"
  is_uint "$DEFAULT_HTTP_TIMEOUT" || die "config: http_timeout must be a non-negative integer"
  DEFAULT_HTTP_RETRIES="${MAIN[http_retries]:-3}"
  is_uint "$DEFAULT_HTTP_RETRIES" || die "config: http_retries must be a non-negative integer"
  DEFAULT_USER_AGENT="${MAIN[user_agent]:-ip-allowlist}"

  DEFAULT_MIN_ENTRIES="${MAIN[min_entries]:-}"
  [[ -z "$DEFAULT_MIN_ENTRIES" ]] || is_uint "$DEFAULT_MIN_ENTRIES" \
    || die "config: min_entries must be a non-negative integer"
  DEFAULT_MAX_SHRINK_RATIO="${MAIN[max_shrink_ratio]:-0.5}"
  [[ "$DEFAULT_MAX_SHRINK_RATIO" =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]] \
    || die "config: max_shrink_ratio must be between 0 and 1"

  UPDATE_INTERVAL=$(parse_duration "${MAIN[update_interval]:-1d}")
  TIMER_INTERVAL=$(parse_duration "${MAIN[timer_interval]:-15m}")
  UPDATE_CHECK_INTERVAL=$(parse_duration "${MAIN[update_check_interval]:-1d}")

  REPO="${MAIN[repo]:-SemouSky/ip-allowlist}"
  [[ "$REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "config: invalid repo '$REPO'"

  FAIL2BAN_DROPIN="${MAIN[fail2ban_ignoreip_file]:-/etc/fail2ban/jail.d/zz-ip-allowlist.local}"
  FIREWALLD_ZONE="${MAIN[firewalld_zone]:-}"
  if [[ -n "$FIREWALLD_ZONE" ]]; then
    [[ "$FIREWALLD_ZONE" =~ ^[A-Za-z0-9_-]+$ ]] || die "config: invalid firewalld_zone '$FIREWALLD_ZONE'"
  fi

  STATE_DIR=$(resolve_path "$CONFIG_BASE_DIR" "${MAIN[state_dir]:-/var/lib/ip-allowlist}")
  SOURCES_DIR=$(resolve_path "$CONFIG_BASE_DIR" "${MAIN[sources_dir]:-/etc/ip-allowlist/sources.d}")
  path_has_no_spaces "$STATE_DIR" || die "config: state_dir must not contain spaces"
  path_has_no_spaces "$SOURCES_DIR" || die "config: sources_dir must not contain spaces"

  local lf="${MAIN[log_file]:-}"
  if [[ -n "$lf" ]]; then
    LOG_FILE=$(resolve_path "$CONFIG_BASE_DIR" "$lf")
    path_has_no_spaces "$LOG_FILE" || die "config: log_file must not contain spaces"
  else
    LOG_FILE=""
  fi

  SNAPSHOT_RETENTION="${MAIN[snapshot_retention]:-3}"
  is_uint "$SNAPSHOT_RETENTION" || die "config: snapshot_retention must be a non-negative integer"
  LOCK_FILE=$(resolve_path "$CONFIG_BASE_DIR" "${MAIN[lock_file]:-/run/ip-allowlist.lock}")
  path_has_no_spaces "$LOCK_FILE" || die "config: lock_file must not contain spaces"
  LOCK_WAIT="${MAIN[lock_wait]:-30}"
  is_uint "$LOCK_WAIT" || die "config: lock_wait must be a non-negative integer"

  LOG_TARGET="${MAIN[log_target]:-auto}"
  LOG_FORMAT="${MAIN[log_format]:-text}"
  case "$LOG_FORMAT" in text|json) ;; *) die "config: invalid log_format '$LOG_FORMAT'" ;; esac
  if (( LOG_LEVEL_CLI == 0 )); then
    local lvl="${MAIN[log_level]:-info}"
    case "$lvl" in debug|info|warn|error) ;; *) die "config: invalid log_level '$lvl'" ;; esac
    LOG_LEVEL=$(log_level_value "$lvl")
  fi
  log_configure_targets

  validate_schema_version
}

# Validate a normalized boolean value.
validate_bool() {
  local key="$1" value="$2" file="$3"
  case "$value" in true|false) ;; *) die "config: invalid $key in $file" ;; esac
}

# Apply config schema migrations and reject configs from newer versions.
migrate_config() {
  local from="$1" to="$2"
  # No migrations are defined yet; future versions add steps here, for example:
  #   if (( from < 2 )); then MAIN[new_key]="${MAIN[new_key]:-default}"; fi
  log_debug "config: no migrations required from schema $from to $to"
}

validate_schema_version() {
  local declared="${MAIN[schema_version]:-$CONFIG_SCHEMA_VERSION}"
  if ! is_uint "$declared"; then
    die "config: schema_version must be a non-negative integer (got '$declared')"
  fi
  if (( declared > CONFIG_SCHEMA_VERSION )); then
    die "config: schema_version $declared is newer than supported $CONFIG_SCHEMA_VERSION; upgrade ip-allowlist"
  fi
  if (( declared < CONFIG_SCHEMA_VERSION )); then
    log_warn "config: schema_version $declared is older than $CONFIG_SCHEMA_VERSION; applying migrations"
    migrate_config "$declared" "$CONFIG_SCHEMA_VERSION"
  fi
}

setup_logging() {
  RUN_ID="$(date +%s)-$$"
  if (( LOG_EMIT_FILE == 1 )) && [[ -n "$LOG_FILE" ]]; then
    mkdir -p -- "$(dirname -- "$LOG_FILE")" 2>/dev/null || true
    if ! touch "$LOG_FILE" 2>/dev/null; then
      err "WARN: cannot write log file $LOG_FILE, disabling file logging"
      LOG_EMIT_FILE=0
    fi
  fi
  if (( LOG_EMIT_SYSLOG == 1 )) && ! have logger; then
    err "WARN: log_target includes syslog but 'logger' is not available"
    LOG_EMIT_SYSLOG=0
  fi
}

# ---------------------------------------------------------------------------
# Conflict detection
# ---------------------------------------------------------------------------

ufw_active() {
  have ufw || return 1
  ufw status 2>/dev/null | grep -qi '^Status:[[:space:]]*active'
}

firewalld_active() {
  have firewall-cmd || return 1
  firewall-cmd --state >/dev/null 2>&1
}

# Reject mismatched active firewall managers, unless overridden by
# allow_conflicting_firewall=true or --force.
firewall_check_conflicts() {
  local configured="$1"
  local u=0 f=0
  ufw_active && u=1
  firewalld_active && f=1

  local conflict=""
  if (( u == 1 && f == 1 )); then
    conflict="both ufw and firewalld are active"
  elif (( u == 1 )) && [[ "$configured" != "ufw" ]]; then
    conflict="ufw is active but firewall_backend=$configured"
  elif (( f == 1 )) && [[ "$configured" != "firewalld" ]]; then
    conflict="firewalld is active but firewall_backend=$configured"
  fi
  [[ -n "$conflict" ]] || return 0

  if [[ "$ALLOW_CONFLICTING_FIREWALL" == "true" || "${FORCE:-0}" -eq 1 ]]; then
    log_warn "firewall conflict overridden: $conflict"
    return 0
  fi
  die "$conflict; set firewall_backend accordingly, or allow_conflicting_firewall=true / --force"
}

# ---------------------------------------------------------------------------
# Backend dispatch
#
# Backend validity is centralized in is_valid_backend(); these dispatchers only
# select behaviour for a backend that has already been validated.
# ---------------------------------------------------------------------------

backend_validate() {
  case "$BACKEND" in
    nft) nft_validate ;;
    ufw) ufw_validate ;;
    firewalld) firewalld_validate ;;
  esac
}

  LOG_COMPONENT=firewall
backend_apply() {
  case "$BACKEND" in
    nft) nft_apply "$STATE_DIR" ;;
    ufw) ufw_apply "$STATE_DIR" ;;
    firewalld) firewalld_apply "$STATE_DIR" ;;
  esac
}

backend_snapshot() {
  local out="$1"
  case "$BACKEND" in
    nft) nft_snapshot "$out" ;;
    ufw) ufw_snapshot "$out" ;;
    firewalld) firewalld_snapshot "$out" ;;
  esac
}

backend_cleanup() {
  case "$BACKEND" in
    nft) nft_cleanup ;;
    ufw) ufw_cleanup ;;
    firewalld) firewalld_cleanup ;;
  esac
}

backend_status() {
  case "$BACKEND" in
    nft) nft_status ;;
    ufw) ufw_status ;;
    firewalld) firewalld_status ;;
  esac
}

# Verify the applied firewall state matches the desired state.
backend_verify() {
  case "$BACKEND" in
    nft) nft_verify "$STATE_DIR" ;;
    ufw) ufw_verify "$STATE_DIR" ;;
    firewalld) firewalld_verify "$STATE_DIR" ;;
  esac
}

# Snapshot the backend's configuration files before applying (best effort).
backend_snapshot_files() {
  case "$BACKEND" in
    nft) nft_snapshot_files ;;
    ufw) ufw_snapshot_files ;;
    firewalld) firewalld_snapshot_files ;;
  esac
}

# Verify removed sources are gone.
# Usage: backend_verify_orphans <state_dir> <name> ...
backend_verify_orphans() {
  local state_dir="$1"; shift
  case "$BACKEND" in
    nft) nft_verify_orphans "$@" ;;
    ufw) ufw_verify_orphans "$@" ;;
    firewalld) firewalld_verify_orphans "$state_dir" "$@" ;;
    *) return 0 ;;
  esac
}

# Verify a previous backend's objects are gone (direct CLI checks so the old
# backend module does not need to be loaded).
# Usage: backend_verify_previous_cleaned <backend> <zone>
backend_verify_previous_cleaned() {
  local backend="$1" zone="$2"
  case "$backend" in
    nft)
      have nft || return 0
      nft list table inet ip_allowlist >/dev/null 2>&1 && return 1
      nft list table inet ip-allowlist >/dev/null 2>&1 && return 1
      return 0
      ;;
    ufw)
      have ufw || return 0
      ufw show added 2>/dev/null | grep -Fq 'ip-allowlist:' && return 1
      return 0
      ;;
    firewalld)
      have firewall-cmd || return 0
      firewall-cmd --permanent --get-ipsets 2>/dev/null | tr ' ' '\n' | grep -q '^ia-' && return 1
      if [[ -n "$zone" ]] && firewall-cmd --permanent --zone="$zone" --list-rich-rules 2>/dev/null | grep -Fq 'ipset="ia-'; then
        return 1
      fi
      return 0
      ;;
  esac
  return 0
}

# Restore the backend's configuration files (last-resort rollback).
backend_restore_files() {
  case "$BACKEND" in
    nft) nft_restore_files ;;
    ufw) ufw_restore_files ;;
    firewalld) firewalld_restore_files ;;
  esac
}

# Restore the given sources from their snapshots (used for rollback).
rollback_sources() {
  local n
  for n in "$@"; do
    [[ -n "$n" ]] || continue
    if state_restore_latest_snapshot "$n"; then
      log_warn "rolled back source $n to its previous values"
    fi
  done
}

# Remove artifacts belonging to a backend we are switching away from.
# Runs in a subshell so sourcing the old backend cannot clobber the current one.
# Usage: cleanup_previous_backend <backend> <firewalld_zone>
cleanup_previous_backend() {
  local backend="$1" zone="$2"
  [[ -n "$backend" ]] || return 0
  is_valid_backend "$backend" || return 0
  [[ "$backend" == "$BACKEND" ]] && return 0
  log_info "removing objects left by previous backend: $backend"
  case "$backend" in
    nft)
      (
        # shellcheck source=/dev/null
        source "$IP_ALLOWLIST_ROOT/lib/firewall/nft.sh"
        nft_cleanup
      )
      ;;
    ufw)
      (
        # shellcheck source=/dev/null
        source "$IP_ALLOWLIST_ROOT/lib/firewall/ufw.sh"
        ufw_cleanup
      )
      ;;
    firewalld)
      (
        # shellcheck source=/dev/null
        source "$IP_ALLOWLIST_ROOT/lib/firewall/firewalld.sh"
        FIREWALLD_ZONE="$zone"
        firewalld_cleanup
      )
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Source loading
# ---------------------------------------------------------------------------

declare -A SOURCES=()
declare -A SOURCE_SAFE_NAMES=()
SOURCE_NAMES=()

load_sources() {
  SOURCES=()
  SOURCE_SAFE_NAMES=()
  SOURCE_NAMES=()
  local f
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    local -A s=()
    source_load_config s "$f"
    local name="${s[name]}"

    # Rule parameters: source config overrides the main defaults.
    if [[ -z "${s[allow_ports]:-}" ]]; then s[allow_ports]="$DEFAULT_ALLOW_PORTS"; fi
    valid_ports_spec "${s[allow_ports]}" || die "source $f: invalid allow_ports '${s[allow_ports]}'"
    s[allow_ports]=$(normalize_ports "${s[allow_ports]}")

    if [[ -z "${s[allow_protocol]:-}" ]]; then s[allow_protocol]="$DEFAULT_ALLOW_PROTOCOL"; fi
    valid_protocol_spec "${s[allow_protocol]}" || die "source $f: invalid allow_protocol '${s[allow_protocol]}'"
    s[allow_protocol]=$(normalize_protocol "${s[allow_protocol]}")

    if [[ -z "${s[enable_ipv4]:-}" ]]; then s[enable_ipv4]="$DEFAULT_ENABLE_IPV4"; fi
    s[enable_ipv4]=$(normalize_bool "${s[enable_ipv4]}")
    case "${s[enable_ipv4]}" in true|false) ;; *) die "source $f: invalid enable_ipv4 '${s[enable_ipv4]}'" ;; esac

    if [[ -z "${s[enable_ipv6]:-}" ]]; then s[enable_ipv6]="$DEFAULT_ENABLE_IPV6"; fi
    s[enable_ipv6]=$(normalize_bool "${s[enable_ipv6]}")
    case "${s[enable_ipv6]}" in true|false) ;; *) die "source $f: invalid enable_ipv6 '${s[enable_ipv6]}'" ;; esac

    if [[ -z "${s[ipv6_required]:-}" ]]; then s[ipv6_required]="$DEFAULT_IPV6_REQUIRED"; fi
    s[ipv6_required]=$(normalize_bool "${s[ipv6_required]}")
    case "${s[ipv6_required]}" in true|false) ;; *) die "source $f: invalid ipv6_required" ;; esac

    if [[ -z "${s[firewall_enabled]:-}" ]]; then s[firewall_enabled]="$DEFAULT_FIREWALL_ENABLED"; fi
    s[firewall_enabled]=$(normalize_bool "${s[firewall_enabled]}")
    case "${s[firewall_enabled]}" in true|false) ;; *) die "source $f: invalid firewall_enabled" ;; esac

    if [[ -z "${s[fail2ban_enabled]:-}" ]]; then s[fail2ban_enabled]="$DEFAULT_FAIL2BAN_ENABLED"; fi
    s[fail2ban_enabled]=$(normalize_bool "${s[fail2ban_enabled]}")
    case "${s[fail2ban_enabled]}" in true|false) ;; *) die "source $f: invalid fail2ban_enabled" ;; esac

    if [[ -z "${s[http_timeout]:-}" ]]; then s[http_timeout]="$DEFAULT_HTTP_TIMEOUT"; fi
    if [[ -z "${s[http_retries]:-}" ]]; then s[http_retries]="$DEFAULT_HTTP_RETRIES"; fi
    if [[ -z "${s[user_agent]:-}" ]]; then s[user_agent]="$DEFAULT_USER_AGENT"; fi
    if [[ -z "${s[min_entries]:-}" ]]; then s[min_entries]="${DEFAULT_MIN_ENTRIES:-1}"; fi
    if [[ -z "${s[max_shrink_ratio]:-}" ]]; then s[max_shrink_ratio]="$DEFAULT_MAX_SHRINK_RATIO"; fi

    if [[ -n "${SOURCES[$name]:-}" ]]; then
      die "duplicate source name '$name' (in $f and ${SOURCES[$name]})"
    fi
    # Firewall object names collapse '-' and '_' to '_', so guard against
    # two distinct source names producing the same set/chain object.
    local safe="${name//-/_}"
    if [[ -n "${SOURCE_SAFE_NAMES[$safe]:-}" ]]; then
      die "source '$name' collides with '${SOURCE_SAFE_NAMES[$safe]}' after firewall object naming (dashes and underscores are equivalent); rename one source"
    fi
    SOURCE_SAFE_NAMES["$safe"]="$name"
    SOURCES["$name"]="$f"
    SOURCE_NAMES+=("$name")
    # Stash parsed config in a per-name associative array via dynamic scope.
    declare -gA "SRC_${safe}=()"
    local -n ref="SRC_${safe}"
    local k
    for k in "${!s[@]}"; do
      ref["$k"]="${s[$k]}"
    done
  done < <(source_list_files "$SOURCES_DIR")
}

source_ref() {
  local name="$1"
  printf 'SRC_%s' "${name//-/_}"
}

# True when a source is selected by --source (or no filter was given).
source_selected() {
  (( ${#SOURCE_FILTER[@]} == 0 )) && return 0
  local n
  for n in "${SOURCE_FILTER[@]}"; do
    [[ "$n" == "$1" ]] && return 0
  done
  return 1
}

# Validate --source filters against configured sources.
validate_source_filter() {
  local sel name found
  for sel in "${SOURCE_FILTER[@]:-}"; do
    [[ -n "$sel" ]] || continue
    found=0
    for name in "${SOURCE_NAMES[@]}"; do
      [[ "$name" == "$sel" ]] && { found=1; break; }
    done
    (( found == 1 )) || die "unknown source '--source $sel'"
  done
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_version() {
  local source=""
  if [[ -f "$STATE_DIR/install-source" ]]; then
    source=$(tr -d '[:space:]' <"$STATE_DIR/install-source" 2>/dev/null || true)
  fi
  if (( JSON_OUT == 1 )); then
    printf '{"name":"ip-allowlist","version":"%s","install_source":"%s"}\n' \
      "$IP_ALLOWLIST_VERSION" "$(json_escape "$source")"
  else
    printf 'ip-allowlist %s\n' "$IP_ALLOWLIST_VERSION"
    [[ -n "$source" ]] && printf 'installed from: %s\n' "$source"
  fi
}

# Query the latest available version: git ls-remote when available, else the
# GitHub release API. Best effort; never fatal.
latest_remote_version() {
  local tag=""
  if have git; then
    tag=$(git ls-remote --tags --refs "https://github.com/${REPO}.git" 2>/dev/null \
      | sed 's#.*refs/tags/##' | grep -E '^v?[0-9]' | sort -V | tail -n1) || true
  fi
  if [[ -z "$tag" ]]; then
    tag=$(http_fetch "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null \
      | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n1 \
      | sed 's/.*"\([^"]*\)"$/\1/') || true
  fi
  printf '%s' "${tag#v}"
}

# Install a specific version from its release tarball (non-interactive).
# Usage: auto_upgrade <version>
auto_upgrade() {
  local latest="$1"
  local url="https://github.com/${REPO}/releases/download/v${latest}/ip-allowlist-${latest}.tar.gz"
  local work
  work=$(tmpdir "autoupdate")
  log_info "auto_update: installing $latest"
  if ! http_fetch "$url" >"$work/release.tar.gz" 2>/dev/null; then
    log_warn "auto_update: download failed for $latest"
    return 1
  fi
  if ! tar -xzf "$work/release.tar.gz" -C "$work" 2>/dev/null; then
    log_warn "auto_update: extraction failed"
    return 1
  fi
  local dir="$work/ip-allowlist-${latest}"
  [[ -x "$dir/install.sh" ]] || { log_warn "auto_update: unexpected archive layout"; return 1; }
  if ! "$dir/install.sh" --yes >/dev/null 2>&1; then
    log_warn "auto_update: install failed"
    return 1
  fi
  return 0
}

# Periodic self-update check (recorded in state, surfaced by status).
update_check_maybe() {
  [[ "${IP_ALLOWLIST_SKIP_UPDATE_CHECK:-0}" == "1" ]] && return 0
  (( OFFLINE == 1 )) && return 0
  local last now
  last=$(state_get_key "last-update-check")
  now=$(date +%s)
  is_uint "$last" || last=0
  (( now - last < UPDATE_CHECK_INTERVAL )) && return 0
  state_set_key "last-update-check" "$now"
  local latest
  latest=$(latest_remote_version)
  [[ -n "$latest" ]] || return 0
  state_set_key "latest-known-version" "$latest"
  [[ "$latest" == "$IP_ALLOWLIST_VERSION" ]] && return 0
  log_info "new version available: $latest (current $IP_ALLOWLIST_VERSION)"

  if [[ "$AUTO_UPDATE" != "true" ]]; then
    return 0
  fi
  # Guard against upgrade loops; the re-executed run skips the check.
  if [[ "${IP_ALLOWLIST_UPGRADED:-0}" == "1" ]]; then
    return 0
  fi
  if auto_upgrade "$latest"; then
    log_info "auto_update: upgraded to $latest; re-executing"
    export IP_ALLOWLIST_UPGRADED=1
    local bin="/usr/local/sbin/ip-allowlist"
    [[ -x "$bin" ]] || bin="$IP_ALLOWLIST_ROOT/ip-allowlist"
    lock_release
    exec "$bin" sync
  fi
  log_warn "auto_update: upgrade to $latest failed; continuing with the current version"
  AUTO_UPDATE_FAILED=1
  return 0
}

cmd_sync() {
  [[ -d "$SOURCES_DIR" ]] || die "sources dir not found or unreadable: $SOURCES_DIR"
  state_init "$STATE_DIR"
  FIREWALL_CHANGED_SOURCES=()
  FIREWALL_REMOVED_SOURCES=()
  FIREWALL_FULL_REBUILD=0

  # Determine ready targets. A target that is not available is skipped with a
  # warning; if every target is skipped the run is a no-op and exits 0.
  local firewall_ready=0 fail2ban_ready=0
  if [[ "$FIREWALL_ENABLED" == "true" ]]; then
    firewall_ready=1
    case "$BACKEND" in
      nft) nft_available || { log_warn "nft is not available; skipping firewall target"; firewall_ready=0; } ;;
      ufw) ufw_available || { log_warn "ufw is not available; skipping firewall target"; firewall_ready=0; } ;;
      firewalld) { firewalld_available && firewalld_service_ready; } \
        || { log_warn "firewalld is not ready; skipping firewall target"; firewall_ready=0; } ;;
    esac
    if (( firewall_ready == 1 )); then
      firewall_check_conflicts "$BACKEND"
    fi
  else
    log_debug "firewall_enabled=false; skipping firewall target"
  fi

  if [[ "$FAIL2BAN_ENABLED" == "true" ]]; then
    fail2ban_ready=1
    if [[ ! -d "$(dirname -- "$FAIL2BAN_DROPIN")" ]]; then
      log_warn "fail2ban drop-in directory $(dirname -- "$FAIL2BAN_DROPIN") missing; skipping fail2ban target"
      fail2ban_ready=0
    fi
  else
    log_debug "fail2ban_enabled=false; skipping fail2ban target"
  fi

  if (( firewall_ready == 0 && fail2ban_ready == 0 )); then
    log_info "no ready targets; nothing to do"
    return 0
  fi

  # Capture what the previous run recorded before any state is overwritten.
  local prev_backend prev_firewalld_zone prev_dropin
  prev_backend=$(state_get_key "backend")
  prev_firewalld_zone=$(state_get_key "firewall.firewalld-zone")
  prev_dropin=$(state_get_key "fail2ban.ignoreip-file")

  if [[ "${IP_ALLOWLIST_TIMER:-0}" == "1" ]]; then
    # Timer runs must never wait: skip when another run holds the lock.
    if ! lock_try "$LOCK_FILE"; then
      log_info "another run holds the lock; skipping this timer run"
      return 0
    fi
  else
    lock_acquire "$LOCK_FILE"
  fi

  if state_in_progress; then
    local inprog_started
    inprog_started=$(state_in_progress_started)
    log_warn "previous run did not complete; rolling back to pre-run snapshots"
    local rname
    for rname in "${SOURCE_NAMES[@]}"; do
      if state_restore_snapshot_since "$rname" "${inprog_started:-0}"; then
        log_warn "source $rname: restored the snapshot taken before the interrupted run"
      elif [[ ! -f "$STATE_DIR/current/${rname}.ips" ]]; then
        if state_restore_latest_snapshot "$rname"; then
          log_warn "source $rname: restored last snapshot"
        fi
      fi
    done
    state_clear_in_progress
  fi

  validate_source_filter

  # Safety guard: refuse to clear everything when no source is active unless
  # explicitly allowed.
  local active_count=0 cname
  for cname in "${SOURCE_NAMES[@]}"; do
    local cref
    cref=$(source_ref "$cname")
    local -n csrc="$cref"
    [[ "${csrc[enabled]}" == "true" ]] || continue
    source_selected "$cname" || continue
    active_count=$(( active_count + 1 ))
  done
  if (( active_count == 0 )) && [[ "$ALLOW_EMPTY_SOURCES" != "true" && $ALLOW_EMPTY -eq 0 ]]; then
    die "no active sources; refusing to clear existing rules (set allow_empty_sources=true or use --allow-empty)"
  fi

  state_mark_in_progress

  update_check_maybe

  local changed_names=()
  local failures=0
  local needs_apply=0
  local name
  for name in "${SOURCE_NAMES[@]}"; do
    local ref
    ref=$(source_ref "$name")
    local -n src="$ref"

    if ! source_selected "$name"; then
      log_debug "source $name: not selected by --source, preserving"
      continue
    fi

    if [[ "${src[enabled]}" != "true" ]]; then
      if [[ -f "$STATE_DIR/current/${name}.ips" || -f "$STATE_DIR/rules/${name}.conf" ]] \
        || state_known_has "$name"; then
        log_info "source $name: disabled, removing from firewall"
        state_remove_source "$name"
        state_known_remove "$name"
        FIREWALL_REMOVED_SOURCES+=("$name")
        needs_apply=1
      else
        log_debug "source $name: disabled, skipping"
      fi
      continue
    fi

    local interval="${src[update_interval]:-$UPDATE_INTERVAL}"
    if (( FORCE == 0 )) && ! source_is_due "$STATE_DIR" "$name" "$interval"; then
      log_debug "source $name: not due (interval ${interval}s), skipping"
      continue
    fi

    state_snapshot_source "$name"

    local new_hash old_hash count
    if ! source_process "$ref" "$STATE_DIR" "$CONFIG_BASE_DIR"; then
      log_error "source $name: processing failed; keeping previous values"
      state_mark_stale "$name"
      failures=$(( failures + 1 ))
      continue
    fi
    count="${src[_entries]}"
    state_mark_run "$name"
    state_clear_stale "$name"
    state_write_rule_spec "$name" "${src[allow_ports]}" "${src[allow_protocol]}" \
      "${src[enable_ipv4]}" "${src[enable_ipv6]}"

    new_hash=$(source_effective_hash "$STATE_DIR" "$name" "${src[allow_ports]}" \
      "${src[allow_protocol]}" "${src[enable_ipv4]}" "${src[enable_ipv6]}")
    old_hash=$(state_get_applied_hash "$name")

    if [[ "$new_hash" != "$old_hash" ]]; then
      changed_names+=("$name")
      needs_apply=1
      log_info "source $name: changed ($count entries)"
    else
      log_debug "source $name: unchanged"
    fi
  done

  # Remove stale state for sources no longer present in the config. A partial
  # run (--source) preserves every unselected source, so orphans are not
  # considered.
  local current_file orphan known
  if (( ${#SOURCE_FILTER[@]} == 0 )); then
    for current_file in "$STATE_DIR"/current/*.ips; do
      [[ -e "$current_file" ]] || continue
      orphan=$(basename -- "$current_file" .ips)
      known=0
      for name in "${SOURCE_NAMES[@]}"; do
        if [[ "$name" == "$orphan" ]]; then known=1; break; fi
      done
      if (( known == 0 )); then
        log_info "source $orphan: no longer configured, removing from firewall"
        rm -f -- "$current_file"
        state_remove_source "$orphan"
        state_known_remove "$orphan"
        FIREWALL_REMOVED_SOURCES+=("$orphan")
        needs_apply=1
      fi
    done

    # Sources recorded in the known list but absent from the config.
    local kname in_cfg
    while IFS= read -r kname; do
      [[ -n "$kname" ]] || continue
      in_cfg=0
      for name in "${SOURCE_NAMES[@]}"; do
        if [[ "$name" == "$kname" ]]; then in_cfg=1; break; fi
      done
      if (( in_cfg == 0 )); then
        log_info "source $kname: no longer configured, removing from firewall"
        state_remove_source "$kname"
        state_known_remove "$kname"
        FIREWALL_REMOVED_SOURCES+=("$kname")
        needs_apply=1
      fi
    done < <(state_known_list)
  fi

  # A backend change requires a rebuild so the new backend gets the allow-list.
  local backend_changed=0
  if [[ -n "$prev_backend" && "$prev_backend" != "$BACKEND" ]] && is_valid_backend "$prev_backend"; then
    backend_changed=1
    needs_apply=1
    FIREWALL_FULL_REBUILD=1
    log_info "backend changed from $prev_backend to $BACKEND; rebuilding allow-list"
  fi

  # Global desired-state fingerprint: backend/table/zone plus every source's
  # entries and rule parameters. Catches config-only changes (chain name,
  # table family, zone, allow_ports, ...) that do not alter source data.
  local fp_tmp new_fp old_fp fpname fp_ports fp_protocol
  fp_tmp=$(tmpfile "fingerprint")
  {
    printf 'backend=%s\n' "$BACKEND"
    printf 'zone=%s\n' "$FIREWALLD_ZONE"
    printf 'fail2ban_enabled=%s\n' "$FAIL2BAN_ENABLED"
    printf 'fail2ban_file=%s\n' "$FAIL2BAN_DROPIN"
    for fpname in "${SOURCE_NAMES[@]}"; do
      [[ -f "$STATE_DIR/current/${fpname}.ips" ]] || continue
      fp_ports=$(rule_spec_get "$STATE_DIR" "$fpname" allow_ports any)
      fp_protocol=$(rule_spec_get "$STATE_DIR" "$fpname" allow_protocol any)
      printf 'src=%s hash=%s\n' "$fpname" \
        "$(source_effective_hash "$STATE_DIR" "$fpname" "$fp_ports" "$fp_protocol" \
          "$(rule_spec_get "$STATE_DIR" "$fpname" enable_ipv4 true)" \
          "$(rule_spec_get "$STATE_DIR" "$fpname" enable_ipv6 true)")"
    done
  } >"$fp_tmp"
  new_fp=$(hash_file "$fp_tmp")
  old_fp=$(cat -- "$STATE_DIR/desired.hash" 2>/dev/null || true)
  if [[ "$new_fp" != "$old_fp" ]]; then
    needs_apply=1
    log_debug "desired firewall state changed"
  fi

  FIREWALL_CHANGED_SOURCES=("${changed_names[@]:-}")

  if (( DRY_RUN == 1 )); then
    if (( needs_apply == 1 )); then
      log_info "dry-run: would apply ${#changed_names[@]} changed and ${#FIREWALL_REMOVED_SOURCES[@]} removed source(s)"
    else
      log_info "dry-run: no firewall changes"
    fi
    if (( fail2ban_ready == 1 )); then
      log_info "dry-run: would reconcile the fail2ban drop-in $FAIL2BAN_DROPIN"
    fi
    state_clear_in_progress
    lock_release
    return 0
  fi

  if (( firewall_ready == 0 )); then
    log_info "firewall target skipped; firewall unchanged"
  elif (( needs_apply == 1 )); then
    local snap
    snap=$(tmpfile "backend-snap")
    log_debug "snapshotting current backend state"
    backend_snapshot "$snap"
    state_snapshot_backend "$BACKEND" "$snap"
    backend_snapshot_files

    if ! backend_apply; then
      log_error "failed to apply firewall rules; state preserved for retry"
      state_clear_in_progress
      lock_release
      exit 2
    fi

    if ! backend_verify; then
      log_error "post-apply verification failed; rolling back"
      rollback_sources "${changed_names[@]:-}"
      if ! backend_apply || ! backend_verify; then
        log_error "logical rollback failed; attempting file-level restore"
        backend_restore_files || true
        if ! backend_apply || ! backend_verify; then
          log_error "rollback failed; manual intervention required"
          state_clear_in_progress
          lock_release
          exit 2
        fi
      fi
      state_clear_in_progress
      lock_release
      log_error "changes rolled back; firewall left at the previous state"
      return 2
    fi

    for name in "${changed_names[@]}"; do
      if [[ -f "$STATE_DIR/current/${name}.ips" ]]; then
        local cref
        cref=$(source_ref "$name")
        local -n csrc="$cref"
        state_set_applied_hash "$name" "$(source_effective_hash "$STATE_DIR" "$name" \
          "${csrc[allow_ports]}" "${csrc[allow_protocol]}" "${csrc[enable_ipv4]}" "${csrc[enable_ipv6]}")"
      fi
    done
    for name in "${SOURCE_NAMES[@]}"; do
      source_selected "$name" || continue
      [[ -f "$STATE_DIR/current/${name}.ips" ]] && state_known_add "$name"
    done
    if ! backend_verify_orphans "$STATE_DIR" "${FIREWALL_REMOVED_SOURCES[@]:-}"; then
      log_error "removed sources still present after apply"
      local rn
      for rn in "${FIREWALL_REMOVED_SOURCES[@]:-}"; do
        [[ -n "$rn" ]] && state_known_add "$rn"
      done
      state_clear_in_progress
      lock_release
      exit 2
    fi

    atomic_install "$fp_tmp" "$STATE_DIR/desired.hash" "0600"
    state_set_backend "$BACKEND"
    if (( backend_changed == 1 )); then
      cleanup_previous_backend "$prev_backend" "$prev_firewalld_zone"
      if ! backend_verify_previous_cleaned "$prev_backend" "$prev_firewalld_zone"; then
        log_error "previous backend $prev_backend still has ip-allowlist objects"
        state_set_key "firewall.residual" "$prev_backend"
        state_clear_in_progress
        lock_release
        exit 2
      fi
      state_set_key "firewall.residual" ""
    fi
  else
    log_info "no source changes; firewall unchanged"
  fi

  if (( fail2ban_ready == 1 )); then
    if [[ -n "$prev_dropin" && "$prev_dropin" != "$FAIL2BAN_DROPIN" && -f "$prev_dropin" ]]; then
      log_info "fail2ban: drop-in path changed, removing old $prev_dropin"
      rm -f -- "$prev_dropin"
    fi
    if fail2ban_apply "$STATE_DIR" "$FAIL2BAN_DROPIN"; then
      state_set_key "fail2ban.ignoreip-file" "$FAIL2BAN_DROPIN"
      fail2ban_reload
    else
      log_error "fail2ban: apply failed; previous drop-in restored"
      failures=$(( failures + 1 ))
    fi
  fi

  state_clear_in_progress
  lock_release
  state_set_key "last-run-id" "$RUN_ID"
  if (( failures > 0 )); then
    log_error "sync completed with $failures source failure(s)"
    return 2
  fi
  if (( AUTO_UPDATE_FAILED == 1 )); then
    log_error "auto_update failed; the current version is unchanged"
    return 2
  fi
  log_info "sync complete"
  return 0
}

cmd_check() {
  state_init "$STATE_DIR"
  validate_source_filter
  local any_changed=0 failures=0 name
  local -a changed=()

  if (( OFFLINE == 1 )); then
    if (( JSON_OUT == 1 )); then
      printf '{"offline":true,"valid":true,"sources":%s}\n' "${#SOURCE_NAMES[@]}"
    else
      out "config valid ($((${#SOURCE_NAMES[@]})) sources); offline mode, no network access"
    fi
    return 0
  fi

  for name in "${SOURCE_NAMES[@]}"; do
    local ref
    ref=$(source_ref "$name")
    local -n src="$ref"
    [[ "${src[enabled]}" == "true" ]] || continue
    source_selected "$name" || continue

    local canonical count new_hash old_hash
    canonical=$(tmpfile "check-canon-${name}")
    if ! source_build "$ref" "$CONFIG_BASE_DIR" "$canonical" "$STATE_DIR/current/${name}.ips"; then
      log_error "source $name: check failed"
      failures=$(( failures + 1 ))
      continue
    fi
    count="${src[_entries]}"
    local ehash_tmp
    ehash_tmp=$(tmpfile "check-hash-${name}")
    {
      cat -- "$canonical"
      printf 'ports=%s\nprotocol=%s\nipv4=%s\nipv6=%s\n' \
        "${src[allow_ports]}" "${src[allow_protocol]}" "${src[enable_ipv4]}" "${src[enable_ipv6]}"
    } >"$ehash_tmp"
    new_hash=$(hash_file "$ehash_tmp")
    old_hash=$(state_get_applied_hash "$name")

    if [[ "$new_hash" != "$old_hash" ]]; then
      any_changed=1
      changed+=("$name")
      log_info "source $name: would change ($count entries)"
    else
      log_info "source $name: no change"
    fi
  done

  if (( JSON_OUT == 1 )); then
    local joined="" first=1
    for name in "${changed[@]:-}"; do
      [[ -n "$name" ]] || continue
      (( first == 1 )) || joined+=","
      first=0
      joined+="\"$(json_escape "$name")\""
    done
    local changed_flag="false"
    (( any_changed == 1 )) && changed_flag="true"
    printf '{"changed":%s,"sources":[%s]}\n' "$changed_flag" "$joined"
  else
    if (( any_changed == 1 )); then
      out "changes pending: ${changed[*]}"
    else
      out "up to date"
    fi
  fi
  if (( failures > 0 )); then
    log_error "check completed with $failures source failure(s)"
    return 2
  fi
  return 0
}

cmd_apply_offline() {
  firewall_check_conflicts "$BACKEND"
  backend_validate
  state_init "$STATE_DIR"

  local prev_backend prev_firewalld_zone prev_dropin
  prev_backend=$(state_get_key "backend")
  prev_firewalld_zone=$(state_get_key "firewall.firewalld-zone")
  prev_dropin=$(state_get_key "fail2ban.ignoreip-file")

  lock_acquire "$LOCK_FILE"

  if ! backend_apply; then
    log_error "failed to apply firewall rules"
    exit 2
  fi
  state_set_backend "$BACKEND"
  cleanup_previous_backend "$prev_backend" "$prev_firewalld_zone"
  if [[ "$FAIL2BAN_ENABLED" == "true" ]]; then
    if [[ -n "$prev_dropin" && "$prev_dropin" != "$FAIL2BAN_DROPIN" && -f "$prev_dropin" ]]; then
      log_info "fail2ban: drop-in path changed, removing old $prev_dropin"
      rm -f -- "$prev_dropin"
    fi
    fail2ban_apply "$STATE_DIR" "$FAIL2BAN_DROPIN"
    state_set_key "fail2ban.ignoreip-file" "$FAIL2BAN_DROPIN"
    fail2ban_reload
  fi
  log_info "applied cached state"
}

cmd_cleanup() {
  backend_validate
  state_init "$STATE_DIR"
  lock_acquire "$LOCK_FILE"
  backend_cleanup
  # Invalidate applied hashes so the next sync rebuilds the allow-list.
  rm -f -- "$STATE_DIR"/applied/*.hash
  if [[ "$FAIL2BAN_ENABLED" == "true" ]]; then
    fail2ban_cleanup "$FAIL2BAN_DROPIN"
  fi
  log_info "cleanup complete"
}

cmd_sources() {
  validate_source_filter
  if (( JSON_OUT == 1 )); then
    printf '['
    local first=1 name
    for name in "${SOURCE_NAMES[@]}"; do
      source_selected "$name" || continue
      local ref
      ref=$(source_ref "$name")
      local -n src="$ref"
      local interval due stale last
      interval="${src[update_interval]:-$UPDATE_INTERVAL}"
      due=false
      source_is_due "$STATE_DIR" "$name" "$interval" && due=true
      stale=false
      state_is_stale "$name" && stale=true
      last="$(state_last_run "$name")"
      (( first == 1 )) || printf ','
      first=0
      printf '{"name":"%s","enabled":%s,"type":"%s","allow_ports":"%s","allow_protocol":"%s","enable_ipv4":%s,"enable_ipv6":%s,"due":%s,"stale":%s,"last_success":"%s","target":"%s"}' \
        "$(json_escape "$name")" "${src[enabled]}" "${src[type]}" \
        "$(json_escape "${src[allow_ports]}")" "$(json_escape "${src[allow_protocol]}")" \
        "${src[enable_ipv4]}" "${src[enable_ipv6]}" "$due" "$stale" "$last" \
        "$(json_escape "$(source_target "$ref")")"
    done
    printf ']\n'
    return 0
  fi

  printf '%-16s %-8s %-6s %-6s %-7s %-16s %s\n' "NAME" "ENABLED" "TYPE" "DUE" "STATUS" "LAST SUCCESS" "TARGET"
  local name
  for name in "${SOURCE_NAMES[@]}"; do
    source_selected "$name" || continue
    local ref
    ref=$(source_ref "$name")
    local -n src="$ref"
    local interval due stale status last
    interval="${src[update_interval]:-$UPDATE_INTERVAL}"
    due="no"
    source_is_due "$STATE_DIR" "$name" "$interval" && due="yes"
    status="ok"
    if state_is_stale "$name"; then status="stale"; fi
    if [[ -z "${src[enabled]}" || "${src[enabled]}" != "true" ]]; then status="disabled"; fi
    last="$(state_last_run "$name")"
    if [[ -n "$last" ]]; then
      last=$(date -u -d "@$last" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$last")
    else
      last="never"
    fi
    printf '%-16s %-8s %-6s %-6s %-7s %-16s %s\n' \
      "$name" "${src[enabled]}" "${src[type]}" "$due" "$status" "$last" "$(source_target "$ref")"
  done
}

cmd_status() {
  state_init "$STATE_DIR"
  validate_source_filter

  local backend_state
  backend_state=$(backend_status)
  local desired_hash f2b_hash f2b_status latest verify_state last_run_id residual
  desired_hash=$(cat -- "$STATE_DIR/desired.hash" 2>/dev/null || true)
  [[ -n "$desired_hash" ]] || desired_hash="none"
  f2b_hash=$(state_fail2ban_hash)
  [[ -n "$f2b_hash" ]] || f2b_hash="none"
  if [[ "$FAIL2BAN_ENABLED" != "true" ]]; then
    f2b_status="disabled"
  elif [[ -f "$FAIL2BAN_DROPIN" ]]; then
    f2b_status="present"
  else
    f2b_status="absent"
  fi
  latest=$(state_get_key "latest-known-version")
  [[ -n "$latest" ]] || latest="unknown"
  last_run_id=$(state_get_key "last-run-id")
  [[ -n "$last_run_id" ]] || last_run_id="none"
  residual=$(state_get_key "firewall.residual")
  verify_state="unknown"
  if [[ "$FIREWALL_ENABLED" != "true" ]]; then
    verify_state="disabled"
  elif (( ${STATUS_CHECK:-0} == 0 )); then
    if backend_verify >/dev/null 2>&1; then verify_state="ok"; else verify_state="mismatch"; fi
  fi

  if [[ $STATUS_CHECK -eq 1 ]]; then
    validate_source_filter
    local issues=0 name
    local enabled_count=0
    for name in "${SOURCE_NAMES[@]}"; do
      local ref
      ref=$(source_ref "$name")
      local -n src="$ref"
      [[ "${src[enabled]}" == "true" ]] || continue
      source_selected "$name" || continue
      enabled_count=$(( enabled_count + 1 ))
      if state_is_stale "$name"; then
        log_error "CRITICAL: source $name is stale (last fetch failed)"
        (( issues < 2 )) && issues=2
      fi
      if [[ -z "$(state_last_run "$name")" ]]; then
        log_error "CRITICAL: source $name has never succeeded"
        (( issues < 2 )) && issues=2
      fi
      local current="$STATE_DIR/current/${name}.ips"
      if [[ ! -f "$current" ]]; then
        log_error "CRITICAL: source $name has no applied state"
        issues=2
        continue
      fi
      local entries
      entries=$(count_lines "$current")
      local min="${src[min_entries]:-1}"
      if (( entries < min )); then
        log_error "CRITICAL: source $name has $entries entries (< min_entries=$min)"
        (( issues < 2 )) && issues=2
      fi
    done
    if state_in_progress; then
      log_error "WARNING: a run is in progress or was interrupted"
      (( issues < 1 )) && issues=1
    fi
    if (( enabled_count == 0 )); then
      err "WARNING: no enabled sources"
      (( issues < 1 )) && issues=1
    fi
    if [[ "$FIREWALL_ENABLED" == "true" && "$backend_state" == "inactive" ]]; then
      err "WARNING: firewall table inactive"
      (( issues < 1 )) && issues=1
    fi
    if [[ -n "$residual" ]]; then
      err "WARNING: $residual objects remain from a previous backend"
      (( issues < 1 )) && issues=1
    fi
    if (( issues == 0 )); then
      out "OK: $enabled_count sources, backend $backend_state"
    fi
    return "$issues"
  fi

  if (( JSON_OUT == 1 )); then
    printf '{"version":"%s","run_id":"%s","firewall_enabled":%s,"backend":"%s","backend_status":"%s","verify":"%s","desired_hash":"%s","residual":"%s","fail2ban":"%s","fail2ban_hash":"%s","latest_version":"%s","state_dir":"%s","in_progress":%s,"sources":[' \
      "$IP_ALLOWLIST_VERSION" "$last_run_id" "$FIREWALL_ENABLED" "$BACKEND" "$(json_escape "$backend_state")" \
      "$verify_state" "$desired_hash" "$(json_escape "$residual")" "$f2b_status" "$f2b_hash" "$(json_escape "$latest")" \
      "$(json_escape "$STATE_DIR")" \
      "$(state_in_progress && echo true || echo false)"
    local first=1 name
    for name in "${SOURCE_NAMES[@]}"; do
      source_selected "$name" || continue
      local ref
      ref=$(source_ref "$name")
      local -n src="$ref"
      local current="$STATE_DIR/current/${name}.ips"
      local entries=0 v4=0 v6=0
      if [[ -f "$current" ]]; then
        entries=$(count_lines "$current")
        read -r v4 v6 < <(count_v4_v6 "$current")
      fi
      local sstatus="ok"
      if [[ "${src[enabled]}" != "true" ]]; then sstatus="disabled"
      elif state_is_stale "$name"; then sstatus="stale"; fi
      local desired=""
      if [[ "${src[enabled]}" == "true" && -f "$current" ]]; then
        desired=$(source_effective_hash "$STATE_DIR" "$name" "${src[allow_ports]}" \
          "${src[allow_protocol]}" "${src[enable_ipv4]}" "${src[enable_ipv6]}")
      fi
      (( first == 1 )) || printf ','
      first=0
      printf '{"name":"%s","enabled":%s,"status":"%s","entries":%s,"v4":%s,"v6":%s,"applied":"%s","desired":"%s","last_success":"%s"}' \
        "$(json_escape "$name")" "${src[enabled]}" "$sstatus" "$entries" "$v4" "$v6" \
        "$(state_get_applied_hash "$name")" "$desired" "$(state_last_run "$name")"
    done
    printf ']}\n'
    return 0
  fi

  printf 'ip-allowlist %s\n' "$IP_ALLOWLIST_VERSION"
  printf 'config:     %s\n' "$CONFIG_FILE"
  printf 'backend:    %s (%s)\n' "$BACKEND" "$backend_state"
  printf 'verify:     %s\n' "$verify_state"
  printf 'desired:    %s\n' "${desired_hash:0:16}"
  printf 'fail2ban:   %s (hash %s)\n' "$f2b_status" "${f2b_hash:0:16}"
  printf 'latest:     %s\n' "$latest"
  printf 'run id:     %s\n' "$last_run_id"
  [[ -n "$residual" ]] && printf 'residual:   %s objects left by a previous backend\n' "$residual"
  printf 'state dir:  %s\n' "$STATE_DIR"
  if state_in_progress; then
    printf 'status:     IN PROGRESS (interrupted run detected)\n'
  else
    printf 'status:     idle\n'
  fi
  printf '\n%-20s %-8s %-8s %-6s %-6s %-16s %s\n' "SOURCE" "ENABLED" "ENTRIES" "V4" "V6" "LAST RUN" "HASH"
  local name
  for name in "${SOURCE_NAMES[@]}"; do
    source_selected "$name" || continue
    local ref
    ref=$(source_ref "$name")
    local -n src="$ref"
    local current="$STATE_DIR/current/${name}.ips"
    local entries=0 v4=0 v6=0
    if [[ -f "$current" ]]; then
      entries=$(count_lines "$current")
      read -r v4 v6 < <(count_v4_v6 "$current")
    fi
    local last
    last=$(state_last_run "$name")
    if [[ -n "$last" ]]; then
      last=$(date -u -d "@$last" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$last")
    else
      last="never"
    fi
    local hash
    hash=$(state_get_applied_hash "$name")
    hash="${hash:0:12}"
    printf '%-20s %-8s %-8s %-6s %-6s %-16s %s\n' \
      "$name" "${src[enabled]}" "$entries" "$v4" "$v6" "$last" "${hash:-none}"
  done
}

cmd_upgrade() {
  LOG_COMPONENT=upgrade
  # Offline / pinned installs are delegated straight to install.sh.
  if [[ -n "$UPGRADE_VERSION" ]]; then
    local want="${UPGRADE_VERSION#v}"
    if [[ "$want" != "$IP_ALLOWLIST_VERSION" && "${FORCE:-0}" -eq 0 ]]; then
      local newest
      newest=$(printf '%s\n%s\n' "$IP_ALLOWLIST_VERSION" "$want" | sort -V | tail -n1)
      if [[ "$newest" != "$want" ]]; then
        die "requested version $want is not newer than $IP_ALLOWLIST_VERSION; use --force to downgrade or reinstall"
      fi
    fi
  fi
  if [[ -n "$FROM_DIR" || -n "$FROM_TARBALL" || -n "$UPGRADE_VERSION" ]]; then
    local -a iargs=(--yes)
    [[ -n "$FROM_DIR" ]] && iargs+=(--from-dir "$FROM_DIR")
    [[ -n "$FROM_TARBALL" ]] && iargs+=(--from-tarball "$FROM_TARBALL")
    [[ -n "$UPGRADE_VERSION" ]] && iargs+=(--version "$UPGRADE_VERSION")
    "$IP_ALLOWLIST_ROOT/install.sh" "${iargs[@]}" || return 1
    if (( UPGRADE_SYNC == 1 )); then
      sync_after_upgrade
    fi
    return 0
  fi
  local repo="$REPO"
  local api="https://api.github.com/repos/${repo}/releases/latest"
  local latest
  if ! latest=$(http_fetch "$api" 2>/dev/null | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n1 | sed 's/.*"\([^"]*\)"$/\1/'); then
    die "failed to query latest release"
  fi
  latest="${latest#v}"
  [[ -n "$latest" ]] || die "could not determine latest version"

  if [[ "$latest" == "$IP_ALLOWLIST_VERSION" ]]; then
    out "already up to date ($IP_ALLOWLIST_VERSION)"
    return 0
  fi

  out "current: $IP_ALLOWLIST_VERSION"
  out "latest:  $latest"

  if (( UPGRADE_CHECK == 1 )); then
    return 0
  fi

  if (( ASSUME_YES == 0 )); then
    printf 'Upgrade to %s? [y/N] ' "$latest" >&2
    local answer=""
    read -r answer || true
    case "$answer" in
      y|Y|yes|YES) ;;
      *) out "aborted"; return 0 ;;
    esac
  fi

  local url="https://github.com/${repo}/releases/download/v${latest}/ip-allowlist-${latest}.tar.gz"
  local tmpd
  tmpd=$(tmpdir "upgrade")
  out "downloading $url"
  http_fetch "$url" >"$tmpd/release.tar.gz" || die "download failed"
  tar -xzf "$tmpd/release.tar.gz" -C "$tmpd" || die "extraction failed"
  local extracted="$tmpd/ip-allowlist-${latest}"
  [[ -d "$extracted" ]] || die "unexpected archive layout"
  "$extracted/install.sh" --yes || die "install failed"
  out "upgraded to $latest"
  if (( UPGRADE_SYNC == 1 )); then
    sync_after_upgrade
  fi
}

# Run the freshly installed binary once (used by 'upgrade --sync').
sync_after_upgrade() {
  local bin="/usr/local/sbin/ip-allowlist"
  [[ -x "$bin" ]] || bin="$IP_ALLOWLIST_ROOT/ip-allowlist"
  out "running sync with the new version"
  "$bin" sync || die "sync after upgrade failed"
}

cmd_install() {
  local script="$IP_ALLOWLIST_ROOT/install.sh"
  [[ -f "$script" ]] || die "install.sh not found at $script"
  local -a args=()
  (( ASSUME_YES == 1 )) && args+=(--yes)
  exec "$script" "${args[@]}"
}

cmd_uninstall() {
  local script="$IP_ALLOWLIST_ROOT/uninstall.sh"
  [[ -f "$script" ]] || die "uninstall.sh not found at $script"
  local -a args=()
  (( PURGE == 1 )) && args+=(--purge)
  (( ASSUME_YES == 1 )) && args+=(--yes)
  exec "$script" "${args[@]}"
}

# ---------------------------------------------------------------------------
# Entry
# ---------------------------------------------------------------------------

main() {
  parse_args "$@"
  load_libraries

  # Reclaim temp files and release the lock on every exit path.
  trap 'cleanup_tmp; lock_release' EXIT

  case "$COMMAND" in
    help)
      usage_for "${HELP_TOPIC:-help}"
      exit 0
      ;;
    version)
      cmd_version
      exit 0
      ;;
    install)
      cmd_install
      exit 0
      ;;
    uninstall)
      cmd_uninstall
      exit 0
      ;;
    upgrade)
      cmd_upgrade
      exit $?
      ;;
  esac

  load_main_config
  load_backend "$BACKEND"
  setup_logging
  load_sources

  case "$COMMAND" in
    sync)          cmd_sync ;;
    check)         cmd_check ;;
    apply-offline) cmd_apply_offline ;;
    cleanup)       cmd_cleanup ;;
    sources)       cmd_sources ;;
    status)        cmd_status ;;
    *)
      err "unknown command: $COMMAND"
      usage >&2
      exit 64
      ;;
  esac
}

main "$@"
