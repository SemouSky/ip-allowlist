[Unit]
Description=ip-allowlist firewall allow-list rebuild at boot
Documentation=https://github.com/SemouSky/ip-allowlist
After=nftables.service
ConditionPathExists=/etc/ip-allowlist/config.conf
ConditionPathExists=/etc/ip-allowlist/update-on-boot

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ip-allowlist apply-offline
User=root
Group=root
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
StateDirectory=ip-allowlist
StateDirectoryMode=0700
# "-" makes systemd ignore these paths when they do not exist yet.
ReadWritePaths=-/var/log/ip-allowlist.log -/etc/fail2ban
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
