[Unit]
Description=ip-allowlist firewall allow-list sync
Documentation=https://github.com/SemouSky/ip-allowlist
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/ip-allowlist/config.conf

[Service]
Type=oneshot
Environment=IP_ALLOWLIST_TIMER=1
ExecStart=/usr/local/sbin/ip-allowlist sync
User=root
Group=root
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
StateDirectory=ip-allowlist
StateDirectoryMode=0700
# "-" makes systemd ignore these paths when they do not exist yet.
ReadWritePaths=-/var/log/ip-allowlist.log -/etc/fail2ban
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
